	nop                             xgkick vi07                       
	nop                             iaddiu vi01, vi00, 0x2000         
	nop                             iand vi01, vi13, vi01             
	nop                             nop                               
	nop                             ibne vi01, vi00, q3wdc_whole      
	nop                             nop                               
	nop                             bal vi15, q3clip                  
	nop                             iaddiu vi14, vi00, 0              
q3wdc_whole:
