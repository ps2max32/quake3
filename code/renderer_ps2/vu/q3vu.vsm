q3wdc_loop:
	itof0.xyz vf01, vf01            iaddiu vi02, vi01, 0x7fff         ; itof.0 stage 1; adc.0 stage 2
	ftoi4.xyz vf02, vf02            ior vi12, vi02, vi11              ; ftoi.0 stage 2; or.0 stage 2
	mulq.xy vf04, vf03, Q           mfir.w vf02, vi12                 ; ds.0 stage 2; mfir.0 stage 2
	mul.z vf03, vf03, vf03          iand vi13, vi13, vi12             ; dz.0 stage 2; acc.0 stage 2
	mulax.xyzw ACC, vf31, vf01x     iaddiu vi04, vi04, 3              ; mx.0 stage 1
	madday.xyzw ACC, vf30, vf01y    nop                               ; my.0 stage 1
	maddaz.xyzw ACC, vf29, vf01z    sq.xyzw vf02, -7(vi04)            ; mz.0 stage 1; sqpos.0 stage 2
	maddw.xyzw vf02, vf28, vf00w    sq.xyz vf04, -9(vi04)             ; mw.0 stage 1; sqst.0 stage 2
	mulaw.xyzw ACC, vf21, vf00w     nop                               ; ka.0 stage 2
	msubz.xyzw vf05, vf21, vf03z    nop                               ; kb.0 stage 2
	ftoi0.xyzw vf04, vf06           nop                               ; ki.0 stage 3
	mulaw.xyz ACC, vf26, vf02w      div Q, vf00w, vf02w               ; ca.0 stage 1; div.0 stage 1
	madd.xyz vf03, vf02, vf27       sq.xyzw vf02, 152(vi04)           ; cb.0 stage 1; sqp.0 stage 1
	mulax.xyz ACC, vf25, vf01x      nop                               ; da.0 stage 1
	madday.xyz ACC, vf24, vf01y     sq.xyzw vf04, -11(vi04)           ; db.0 stage 1; sqcol.0 stage 3
	maddaz.xyz ACC, vf23, vf01z     nop                               ; dc.0 stage 1
	clipw.xyz vf03xyz, vf02w        nop                               ; clip.0 stage 1
	maddw.xyz vf03, vf22, vf00w     lq.xyz vf01, -1(vi04)             ; dd.0 stage 1; lqpos.0 stage 0
	mulq.xyz vf02, vf02, Q          ilw.w vi11, -4(vi04)              ; mulq.0 stage 1; lsf.0 stage 1
	addq.z vf04, vf00, Q            ibne vi04, vi05, q3wdc_loop       ; dq.0 stage 1
	maxx.xyzw vf06, vf05, vf00x     fcand vi01, 0x3ffff               ; km.0 stage 2; fc.0 stage 1
	nop                             mfir.x vf10, vi10                 
	nop                             iaddiu vi07, vi08, 17             
	nop                             nop                               
	nop                             sq.xyzw vf10, 17(vi08)            
	nop                             nop                               
